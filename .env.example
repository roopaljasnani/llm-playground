# Server-side only. Never prefix this with VITE_ — that would ship the key to the browser.
# Ollama ignores the value; it only needs to be non-empty so the proxy will start.
OPENAI_API_KEY=ollama

# Local Ollama (OpenAI-compatible). Cloud hosts still work: OpenAI, Groq, OpenRouter, …
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
