# Server-side only. Never prefix this with VITE_ — that would ship the key to the browser.
# Ollama ignores the value; it only needs to be non-empty so the proxy will start.
OPENAI_API_KEY=ollama

# Local Ollama (OpenAI-compatible). Cloud hosts still work: OpenAI, Groq, OpenRouter, …
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Compare starts both model calls at once. Ollama still runs one job at a time
# unless you give it parallel slots and enough RAM for both models:
#   OLLAMA_NUM_PARALLEL=2
#   OLLAMA_MAX_LOADED_MODELS=2
